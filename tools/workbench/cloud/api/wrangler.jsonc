{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "falsify-cloud-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-19",
  // Password hashing uses the native node:crypto scrypt.
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "96aee9d5fb56f2efc3d90e147a67f558",
  "workers_dev": true,
  "preview_urls": false,
  "limits": { "cpu_ms": 1000 },
  "d1_databases": [{ "binding": "DB", "database_name": "falsify-harness-records", "database_id": "1dc5ab19-6f6d-43e0-a30a-e104ab337371", "migrations_dir": "migrations" }],
  "vars": {
    // Exact origins only; local test origins belong in .dev.vars or test bindings, never here.
    "ALLOWED_ORIGINS": "https://shinick-han.github.io,http://127.0.0.1:7816,http://localhost:7816",
    // Fixed Falsify site and space. Client secret, session key, and the full callback URL stay secrets.
    // Shipped default is Confluence-only. Legacy suites must set CONFLUENCE_ONLY to false explicitly.
    "REMOTE_PROVIDER": "confluence",
    "CONFLUENCE_SITE_URL": "https://falsify.atlassian.net",
    "CONFLUENCE_SPACE_KEY": "Falsify",
    "CONFLUENCE_SPACE_ID": "65737",
    // Operator-supplied archive parent in space 65737. Created under workspace page 66042.
    "CONFLUENCE_PARENT_PAGE_ID": "8355842",
    "ATLASSIAN_CLIENT_ID": "LQL1zmOGHXyk8V4ShnSdPJCc5MzJWYDN",
    "CONFLUENCE_ONLY": "true"
  },
  // Platform invocation logs are off (they carry client request metadata); the Worker emits one
  // structured line per request with route template, method, status and duration only.
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "env": {
    "staging": {
      "name": "falsify-cloud-api-staging",
      "vars": {
        "ALLOWED_ORIGINS": "https://shinick-han.github.io,http://127.0.0.1:7849,http://localhost:7849",
        "REMOTE_PROVIDER": "confluence",
        "CONFLUENCE_SITE_URL": "https://falsify.atlassian.net",
        "CONFLUENCE_SPACE_KEY": "Falsify",
        "CONFLUENCE_SPACE_ID": "65737",
        "CONFLUENCE_PARENT_PAGE_ID": "8355842",
        "ATLASSIAN_CLIENT_ID": "LQL1zmOGHXyk8V4ShnSdPJCc5MzJWYDN",
        "CONFLUENCE_ONLY": "true"
      },
      "d1_databases": [{ "binding": "DB", "database_name": "falsify-harness-records-staging", "database_id": "43f6eef6-84a4-4039-9cd5-4e3520cea4e6", "migrations_dir": "migrations" }]
    }
  }
}
