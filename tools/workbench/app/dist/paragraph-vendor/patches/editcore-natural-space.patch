+// Source advances of one layout run, grouped by source font, size and scale.
+// Fonts embedded without a space glyph (TeX subsets) realise a space as
+// positioning: its gap is the space's own source advance or, with the space
+// at 0, folded into the advance of the glyph before it. own(cp) is that
+// glyph's advance without the gap, or < 0 when its metrics are unknown.
+struct SpaceSampleRun {
+    FPDF_FONT font = nullptr;
+    float size = 0;
+    float hScale = 1;
+    const std::u16string* text = nullptr;
+    const std::vector<float>* adv = nullptr;
+    std::function<float(uint32_t)> own;
+};
+
+// Natural interword advance per run (< 0 when unknown): the median source gap
+// of single spaces in the runs sharing its font, size and scale, provided
+// those gaps agree. Nothing is assumed for a font without such evidence.
+std::vector<float> sourceNaturalSpaces(const std::vector<SpaceSampleRun>& runs) {
+    std::vector<float> out(runs.size(), -1.0f);
+    auto same = [](const SpaceSampleRun& a, const SpaceSampleRun& b) {
+        return a.font == b.font && std::abs(a.size - b.size) < 0.01f &&
+               std::abs(a.hScale - b.hScale) < 0.001f;
+    };
+    for (size_t i = 0; i < runs.size(); i++) {
+        if (!runs[i].font || runs[i].size <= 0.0f) continue;
+        std::vector<float> gaps;
+        for (const SpaceSampleRun& r : runs) {
+            if (!same(runs[i], r) || !r.text || !r.adv || !r.own ||
+                r.adv->size() != r.text->size())
+                continue;
+            const std::u16string& t = *r.text;
+            for (size_t k = 1; k + 1 < t.size(); k++) {
+                const char16_t pc = t[k - 1];
+                if (t[k] != u' ' || pc < 0x21 || t[k + 1] < 0x21 ||
+                    (pc >= 0xD800 && pc <= 0xDFFF))
+                    continue;
+                const float pa = (*r.adv)[k - 1], sa = (*r.adv)[k];
+                if (pa <= 0.0f || sa < 0.0f) continue;
+                const float own = r.own(pc);
+                if (own <= 0.0f) continue;
+                const float g = pa + sa - own;
+                if (g > 0.05f * r.size && g < r.size) gaps.push_back(g);
+            }
+        }
+        if (gaps.empty()) continue;
+        std::sort(gaps.begin(), gaps.end());
+        if (gaps.back() - gaps.front() > 0.1f * runs[i].size) continue;
+        out[i] = gaps[gaps.size() / 2];
+    }
+    return out;
+}
