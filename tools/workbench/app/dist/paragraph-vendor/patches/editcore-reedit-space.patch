     liveEndIfOpen(*s);
     auto it = s->pages.find(page);
     if (it == s->pages.end()) return nullptr;
     Paragraph* src = it->second.find(para_id);
     if (!src || !src->editable || src->runs.empty()) return nullptr;
 
     HistoryStep step(*s, page, "duplicate");
     Paragraph p;
     p.id = s->nextParaId++;
     p.x = src->x;
     p.top = src->top;
     p.width = src->width;
     p.rotation = src->rotation;
     p.fmt = src->fmt;
 
