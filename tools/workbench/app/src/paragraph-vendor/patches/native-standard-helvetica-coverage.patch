+bool isPlainStandardHelvetica(Session& s, FPDF_FONT font) {
+#ifndef __EMSCRIPTEN__
+    (void)s; (void)font; return false;
+#else
+    if (!s.doc || !font || FPDFFont_GetIsEmbedded(font) != 0 || fontBaseName(font) != "Helvetica") return false;
+    CPDF_IndirectObjectHolder* holder = abiValidatedHolder(s.doc);
+    CPDF_Dictionary* dict = holder ? abiFontDict(s.doc, holder, font, "Helvetica") : nullptr;
+    if (!dict || abiByteStringChars(dict->GetByteStringFor(fxcrt::StringViewTemplate<char>("BaseFont",8))) != "Helvetica" ||
+        abiByteStringChars(dict->GetByteStringFor(fxcrt::StringViewTemplate<char>("Subtype",7))) != "Type1" ||
+        dict->KeyExist(fxcrt::StringViewTemplate<char>("ToUnicode",9))) return false;
+    for (const auto& key : {"Widths","FirstChar","LastChar","FontDescriptor"})
+        if (dict->KeyExist(fxcrt::StringViewTemplate<char>(key,strlen(key)))) return false;
+    if (!dict->KeyExist(fxcrt::StringViewTemplate<char>("Encoding",8))) return true;
+    const std::string enc = abiByteStringChars(dict->GetByteStringFor(fxcrt::StringViewTemplate<char>("Encoding",8)));
+    return enc == "WinAnsiEncoding" || enc == "StandardEncoding";
+#endif
+}
