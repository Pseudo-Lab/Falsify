+// never invents a document and never treats another payload as a PDF.
+function readablePdf(pdf) {
+  return pdf instanceof Uint8Array && pdf.length >= 5 && pdf[0] === 0x25 && pdf[1] === 0x50 && pdf[2] === 0x44 && pdf[3] === 0x46 && pdf[4] === 0x2d;
