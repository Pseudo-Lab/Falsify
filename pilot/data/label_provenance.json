{
  "schema_version": "1.0",
  "builder": "src/labels.py::build_labels",
  "horizon_days": 180,
  "inputs": [
    "event_day",
    "followup_end_day"
  ],
  "rules": [
    "observed event with 0 < event_day <= 180 -> y=1, observed=true",
    "otherwise followup_end_day >= 180 -> y=0, observed=true",
    "otherwise -> y=null, observed=false (right-censored before day 180)"
  ],
