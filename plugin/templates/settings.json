    "allow": [
      "Read(./runs/**)",
      "Edit(./runs/**)",
      "Bash(python tools/finish_run.py:*)",
      "Bash(python tools/extract_pages.py:*)",
      "Bash(python tools/render_pages.py:*)",
      "Bash(python tools/mw_pvalues.py:*)",
      "Bash(python tools/red_report.py:*)",
      "Bash(python tools/main_make_patch.py:*)",
      "WebFetch(domain:api.crossref.org)",
      "WebFetch(domain:api.datacite.org)",
      "WebFetch(domain:pubmed.ncbi.nlm.nih.gov)",
      "WebFetch(domain:eutils.ncbi.nlm.nih.gov)",
      "WebFetch(domain:drks.de)",
      "WebFetch(domain:clinicaltrials.gov)"
    ]
  },
  "enableAllProjectMcpServers": false
